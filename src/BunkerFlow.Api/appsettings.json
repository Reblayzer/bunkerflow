{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "ServiceBus": {
    "ConnectionString": "",
    "TopicName": "bunkerflow-events",
    "SubscriptionName": "landing",
    "DeadLetterQueueName": "bunkerflow-deadletter"
  },
  "Landing": {
    "ParquetRootPath": "data/landing",
    "BatchSize": 100,
    "FlushIntervalSeconds": 15
  }
}
