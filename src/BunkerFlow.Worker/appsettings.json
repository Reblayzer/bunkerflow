{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Azure.Messaging.ServiceBus": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "ServiceBus": {
    "ConnectionString": "",
    "TopicName": "bunkerflow-events",
    "SubscriptionName": "landing",
    "DeadLetterQueueName": "bunkerflow-deadletter"
  },
  "Landing": {
    "ParquetRootPath": "data/landing",
    "BatchSize": 100,
    "FlushIntervalSeconds": 15
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:19092",
    "Topic": "bunker.trades.raw",
    "ConsumerGroup": "bunkerflow-ingestion",
    "SourceSystem": "port-telemetry",
    "RecordIdField": "sourceRecordId"
  },
  "BatchSources": [
    {
      "Enabled": true,
      "SourceSystem": "trading-desk",
      "Endpoint": "http://localhost:8080/mock-sources/trading-desk/trades?count=25",
      "IntervalSeconds": 30,
      "RecordIdField": "sourceRecordId"
    },
    {
      "Enabled": true,
      "SourceSystem": "erp",
      "Endpoint": "http://localhost:8080/mock-sources/erp/trades?count=25",
      "IntervalSeconds": 45,
      "RecordIdField": "sourceRecordId"
    }
  ]
}
