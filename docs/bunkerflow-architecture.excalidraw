    {
      "type": "text",
      "id": "s3_sub",
      "x": 1560,
      "y": 784,
      "width": 290,
      "height": 54,
      "text": "Every source becomes this shape.\nNothing downstream knows or\ncares where the record came from.",
      "originalText": "Every source becomes this shape.\nNothing downstream knows or\ncares where the record came from.",
