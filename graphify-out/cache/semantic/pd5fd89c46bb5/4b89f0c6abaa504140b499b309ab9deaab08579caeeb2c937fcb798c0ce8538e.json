{"nodes": [{"id": "docs_azure_verification_live_run", "label": "Live Azure Verification Run", "file_type": "concept", "source_file": "docs/azure-verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Terraform was applied to a real Azure subscription on 4 August 2026, the gateway ran against the resulting namespace, and the resources were destroyed afterwards. The file is CLI output from the live deployment, not a description of intent."}, {"id": "docs_azure_verification_least_privilege", "label": "Least Privilege Actually Holds", "file_type": "rationale", "source_file": "docs/azure-verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The gateway published 47 records with a Send-only credential and the landing worker consumed all 47 with a Listen-only one. Against the emulator a single connection string did everything, so the rules were decorative; per-entity rules produce entity-scoped connection strings, which forced the application to take three credentials rather than one."}, {"id": "docs_azure_verification_duplicate_detection", "label": "Broker Duplicate Detection, Proved", "file_type": "concept", "source_file": "docs/azure-verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The application dedupe reservation was deliberately cleared between two identical ingests so the gateway genuinely published the same trade twice. The broker discarded the replay: one trade, one row."}, {"id": "docs_azure_verification_subscription_filter", "label": "Schema Version Subscription Filter, Proved", "file_type": "concept", "source_file": "docs/azure-verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The subscription carries schemaVersion = 1 so a future contract version gets its own consumer instead of quietly corrupting this one. Proving it needed a producer that could lie about the version: v1 landed, v2 did not."}, {"id": "docs_azure_verification_region_capacity", "label": "Region Capacity Constraint", "file_type": "rationale", "source_file": "docs/azure-verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "westeurope refused the namespace with RequestDisallowedByAzure: the region is not accepting new customers. A capacity restriction on new subscriptions, not a configuration error; northeurope accepted it unchanged and is nearer the Nordics anyway."}], "edges": [{"source": "docs_azure_verification_live_run", "target": "terraform_azurerm_servicebus_namespace_bunkerflow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/azure-verification.md", "source_location": null, "weight": 1.0}, {"source": "docs_azure_verification_live_run", "target": "terraform_azurerm_servicebus_topic_events", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/azure-verification.md", "source_location": null, "weight": 1.0}, {"source": "docs_azure_verification_live_run", "target": "terraform_azurerm_servicebus_subscription_landing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/azure-verification.md", "source_location": null, "weight": 1.0}, {"source": "docs_azure_verification_live_run", "target": "terraform_azurerm_servicebus_queue_dead_letter", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/azure-verification.md", "source_location": null, "weight": 1.0}, {"source": "docs_azure_verification_least_privilege", "target": "terraform_azurerm_servicebus_topic_authorization_rule_gateway_send", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1