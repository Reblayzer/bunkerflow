{"nodes": [{"id": "docker_compose_local_stack", "label": "Single-Machine Local Stack", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two brokers, a database, the API and the worker in one compose file, so the whole gateway comes up with docker compose up --build."}, {"id": "docker_compose_redpanda", "label": "Redpanda As Kafka Substitute", "file_type": "rationale", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kafka-API compatible and lighter than a full Kafka plus ZooKeeper pair, and it speaks the same protocol, so Confluent.Kafka needs no changes."}, {"id": "docker_compose_servicebus_emulator", "label": "Service Bus Emulator", "file_type": "rationale", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Terraform provisions the real namespace; the emulator is what makes docker compose up exercise the same code paths without an Azure subscription. It needs an MSSQL backing store."}, {"id": "docker_compose_postgres", "label": "PostgreSQL Service", "file_type": "concept", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backs both the dedupe store and the queryable landing store, with a pg_isready healthcheck the API and worker wait on."}, {"id": "docker_compose_throwaway_key", "label": "Deliberate Throwaway API Key", "file_type": "rationale", "source_file": "docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The compose stack sets an obvious throwaway key so the authenticated path is exercised rather than left dormant. Not a secret, and comme