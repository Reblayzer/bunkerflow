nces", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_scope_honesty", "target": "project_brainstorm_integrity_notes", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_deterministic_event_id", "target": "readme_reserve_then_release", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_common_event_contract", "target": "readme_medallion_layers", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_offset_commit_rule", "target": "readme_dead_letter_paths", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_transient_vs_permanent", "target": "readme_offset_commit_rule", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_reserve_then_release", "target": "readme_silver_dedup_noop", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "README.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "ingestion_to_landing_flow", "label": "Ingest \u2192 Normalize \u2192 Validate \u2192 Dedupe \u2192 Publish \u2192 Land", "nodes": ["src_bunkerflow_worker_ingestion_batchingestionworker_bunkerflow_worker_ingestion_batchingestionworker", "src_bunkerflow_worker_ingestion_kafkaingestionworker_bunkerflow_worker_ingestion_kafkaingestionworker", "src_bunkerflow_integration_pipeline_ingestionpipeline_bunkerflow